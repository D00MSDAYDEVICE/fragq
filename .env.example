# ---------------------------------------------------------------------------
# FragQ configuration. Copy to .env (deployfragq.sh / deployfragq.ps1 do this for you).
# After changing anything here run:  docker compose up -d
# ---------------------------------------------------------------------------

# --- Discord application (https://discord.com/developers/applications) -------
# Bot tab: token. Enable the "Server Members" and "Presence" and "Message Content"
# privileged gateway intents there as well.
DISCORD_BOT_TOKEN=
# OAuth2 tab: client id and secret (used for the web interface login).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your own Discord user id: full access to every server the bot is on.
DISCORD_OWNER_ID=
# Optional: register slash commands only on these server ids (comma separated).
# Empty = global slash commands (can take up to an hour to appear).
DISCORD_SLASH_SERVERS=

# Shown as the bot's "Watching ..." status.
BOT_STATUS=pickup games

# --- Web interface -------------------------------------------------------------
# Domain name or IP address people use to reach the web interface. Several are
# allowed, comma separated. No domain? Use the server's public IP (or LAN IP).
SITE_HOST=

# The full public address of the web interface. Add  <PUBLIC_URL>/auth/callback
# as a Redirect in the Discord developer portal (OAuth2 tab), e.g.
#   PUBLIC_URL=https://fragq.example.com   ->   https://fragq.example.com/auth/callback
PUBLIC_URL=

# Ports published on the host. Any free ports work, e.g. HTTPS_PORT=8443.
HTTP_PORT=80
HTTPS_PORT=443

# auto     : Let's Encrypt for public domains AND public IPs, self-signed for
#            private IPs/LAN names, with an automatic self-signed fallback.
# internal : always self-signed (browser shows a warning once)
# custom   : use ./certs/cert.pem and ./certs/key.pem
# off      : plain HTTP only on HTTP_PORT (when another proxy does TLS)
TLS_MODE=auto

# Optional e-mail for Let's Encrypt expiry/problem notices.
ACME_EMAIL=

# Only with TLS_MODE=off behind another reverse proxy: its IP or range (comma
# separated), or private_ranges.
TRUSTED_PROXIES=

# Signs login cookies. Empty = generated once and kept in the data volume.
SESSION_SECRET=
# How long a login lasts, in days.
SESSION_DAYS=7

# --- Database (MariaDB container) ------------------------------------------------
MYSQL_DATABASE=fragq
MYSQL_USER=fragq
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Use an external MySQL/MariaDB (e.g. an existing PUBobot2 database) instead:
#   DB_URI=mysql://user:password@host:3306/pubodb
DB_URI=

# CHAT, DEBUG, COMMANDS, INFO or ERRORS
LOG_LEVEL=INFO
